# Everything under data/ is private until deposit: the submission files, the working file with
# participant_id and sender, and the raw exports. SCHEMA_raw.md relies on this rule.
data/*
!data/README.md

# Python bytecode cache, a build artefact of running the scripts and the tests.
__pycache__/
*.pyc

# Dated backups of the private files, wherever they get made: a backup of private data is as
# private as the original, and data/* alone would not catch one made outside data/.
*.backup-*.csv

# LaTeX build artefacts under paper/, the same rule as the sibling repositories' papers/. The
# figure PDFs in paper/figures/ are tracked: they are inputs to the build, not outputs of it.
paper/**/*.aux
paper/**/*.log
paper/**/*.out
paper/**/*.toc
paper/**/*.fls
paper/**/*.fdb_latexmk
paper/**/*.xdv
paper/**/*.synctex.gz
paper/main.pdf
